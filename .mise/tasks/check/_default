#!/usr/bin/env bash
#MISE description="Every check CI runs: workflows, spec drift, every package, conformance"
set -euo pipefail
source "$MISE_PROJECT_ROOT/.mise/lib/pkg.sh"
cd "$ROOT"

mise run lint:workflows
mise run check:drift
for p in $(pkg_names); do
  mise run check:package "$p"
done
mise run check:conformance
